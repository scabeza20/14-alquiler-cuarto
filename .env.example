# Correo de destino para las notificaciones del formulario
CONTACT_RECIPIENT_EMAIL=correo@correo.com

# API Key de Resend (https://resend.com) - Gratuito hasta 3,000 correos/mes
RESEND_API_KEY=re_your_api_key_here

# (Opcional) Si usas Web3Forms en lugar de Resend:
# WEB3FORMS_ACCESS_KEY=your_web3forms_key_here
