---
interface Props {
  text?: string;
  size?: 'sm' | 'md' | 'lg';
  floating?: boolean;
  className?: string;
}

const {
  text = 'WhatsApp',
  size = 'md',
  floating = false,
  className = ''
} = Astro.props;

// Enlace directo a la API de WhatsApp sin mostrar el número telefónico en el texto visible
const whatsappUrl = 'https://wa.me/50761196368?text=Hola,%20estoy%20interesado%20en%20el%20alquiler%20del%20cuarto%20en%20La%20Siesta%20de%20Tocumen';
---

{floating ? (
  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="whatsapp-floating"
    aria-label="Contactar por WhatsApp"
    title="Chatear por WhatsApp"
  >
    <svg class="whatsapp-icon" viewBox="0 0 24 24" width="32" height="32" fill="currentColor">
      <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m.01 1.67c4.56 0 8.25 3.69 8.25 8.24 0 2.2-.86 4.28-2.42 5.83a8.194 8.194 0 0 1-5.83 2.41h-.01c-1.49 0-2.94-.4-4.22-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.16 8.16 0 0 1-1.25-4.38c0-4.55 3.7-8.24 8.27-8.24m4.84 11.64c-.2-.1-.7-.35-1.47-.73-.78-.39-.85-.39-1.21.14-.36.54-.46.58-.69.58-.23 0-.9-.23-1.72-.96-.64-.57-1.07-1.28-1.2-1.5-.13-.22-.01-.34.1-.45.1-.1.22-.26.34-.39.11-.13.15-.22.23-.37.08-.15.04-.28-.02-.39-.06-.11-.53-1.28-.73-1.75-.19-.46-.39-.4-.53-.41-.14-.01-.3-.01-.46-.01-.16 0-.42.06-.64.3-.22.24-.85.83-.85 2.02s.87 2.34.99 2.5c.12.16 1.71 2.61 4.14 3.66.58.25 1.03.4 1.38.51.58.18 1.11.16 1.53.1.47-.07 1.44-.59 1.64-1.16.2-.57.2-1.06.14-1.16-.06-.1-.22-.16-.42-.26z"/>
    </svg>
    <span class="whatsapp-tooltip">¿Consultas? Escríbenos</span>
  </a>
) : (
  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    class={`btn btn-whatsapp ${size === 'sm' ? 'btn-sm' : size === 'lg' ? 'btn-lg' : ''} ${className}`}
    aria-label="Abrir chat en WhatsApp"
  >
    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
      <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m.01 1.67c4.56 0 8.25 3.69 8.25 8.24 0 2.2-.86 4.28-2.42 5.83a8.194 8.194 0 0 1-5.83 2.41h-.01c-1.49 0-2.94-.4-4.22-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.16 8.16 0 0 1-1.25-4.38c0-4.55 3.7-8.24 8.27-8.24m4.84 11.64c-.2-.1-.7-.35-1.47-.73-.78-.39-.85-.39-1.21.14-.36.54-.46.58-.69.58-.23 0-.9-.23-1.72-.96-.64-.57-1.07-1.28-1.2-1.5-.13-.22-.01-.34.1-.45.1-.1.22-.26.34-.39.11-.13.15-.22.23-.37.08-.15.04-.28-.02-.39-.06-.11-.53-1.28-.73-1.75-.19-.46-.39-.4-.53-.41-.14-.01-.3-.01-.46-.01-.16 0-.42.06-.64.3-.22.24-.85.83-.85 2.02s.87 2.34.99 2.5c.12.16 1.71 2.61 4.14 3.66.58.25 1.03.4 1.38.51.58.18 1.11.16 1.53.1.47-.07 1.44-.59 1.64-1.16.2-.57.2-1.06.14-1.16-.06-.1-.22-.16-.42-.26z"/>
    </svg>
    <span>{text}</span>
  </a>
)}

<style>
  .whatsapp-floating {
    position: fixed;
    bottom: 24px;
    right: 24px;
    width: 60px;
    height: 60px;
    background-color: var(--color-whatsapp);
    color: var(--color-white);
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 18px rgba(37, 211, 102, 0.45);
    z-index: 999;
    transition: transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.2s ease;
  }

  .whatsapp-floating:hover {
    transform: scale(1.08);
    background-color: var(--color-whatsapp-hover);
    box-shadow: 0 6px 24px rgba(37, 211, 102, 0.6);
  }

  .whatsapp-tooltip {
    position: absolute;
    right: 70px;
    background: var(--color-nordic);
    color: var(--color-white);
    padding: 6px 12px;
    border-radius: var(--radius-md);
    font-size: 0.8rem;
    font-weight: 500;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transform: translateX(10px);
    transition: opacity 0.2s ease, transform 0.2s ease;
    box-shadow: var(--shadow-sm);
  }

  .whatsapp-floating:hover .whatsapp-tooltip {
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 640px) {
    .whatsapp-tooltip {
      display: none;
    }
    .whatsapp-floating {
      bottom: 20px;
      right: 20px;
      width: 54px;
      height: 54px;
    }
  }
</style>
