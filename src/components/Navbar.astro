---
import WhatsAppButton from './WhatsAppButton.astro';
import Icon from './Icon.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
---

<header class="navbar-header">
  <div class="container navbar-container">
    <a href="/" class="navbar-brand" aria-label="Inicio - Alquiler Tocumen">
      <div class="brand-icon">
        <Icon name="apartment" size={20} />
      </div>
      <div class="brand-text">
        <span class="brand-title">Alquiler Tocumen</span>
        <span class="brand-subtitle">Panamá</span>
      </div>
    </a>

    <nav class="navbar-nav" aria-label="Navegación principal">
      <a 
        href="/" 
        class={`nav-link ${currentPath === '/' ? 'active' : ''}`}
      >
        Inicio
      </a>
      <a 
        href="/detalle" 
        class={`nav-link ${currentPath === '/detalle' || currentPath.startsWith('/detalle') ? 'active' : ''}`}
      >
        <span class="nav-text-full">Detalles y Fotos</span>
        <span class="nav-text-compact">Detalles</span>
      </a>
      <a 
        href="/contacto" 
        class={`nav-link ${currentPath === '/contacto' || currentPath.startsWith('/contacto') ? 'active' : ''}`}
      >
        Contacto
      </a>
    </nav>

    <div class="navbar-actions">
      <!-- Dark Mode Toggle Button -->
      <button 
        type="button" 
        id="theme-toggle" 
        class="theme-toggle-btn" 
        aria-label="Cambiar modo claro u oscuro"
        title="Cambiar modo claro / oscuro"
      >
        <Icon name="dark_mode" size={20} class="icon-dark" />
        <Icon name="light_mode" size={20} class="icon-light" />
      </button>

      <WhatsAppButton size="sm" text="WhatsApp" />
    </div>
  </div>
</header>

<script>
  function initThemeToggle() {
    const toggleBtn = document.getElementById('theme-toggle');
    if (!toggleBtn) return;

    toggleBtn.addEventListener('click', () => {
      const currentTheme = document.documentElement.getAttribute('data-theme');
      const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', newTheme);
      localStorage.setItem('theme', newTheme);
    });
  }

  initThemeToggle();
  document.addEventListener('astro:page-load', initThemeToggle);
</script>

<style>
  .navbar-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-navbar-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-navbar-border);
    transition: var(--transition);
  }

  :global([data-theme="dark"]) .navbar-header {
    background-color: var(--color-navbar-bg);
    border-bottom: 1px solid var(--color-navbar-border);
  }

  .navbar-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .navbar-brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
  }

  .brand-icon {
    width: 36px;
    height: 36px;
    background-color: var(--color-nordic);
    color: var(--color-white);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-sm);
  }

  .brand-icon span {
    font-size: 20px;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-title {
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1.2;
    color: var(--color-nordic);
    letter-spacing: -0.02em;
  }

  .brand-subtitle {
    font-size: 0.7rem;
    color: var(--color-nordic-muted);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .navbar-nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .nav-link {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-nordic-muted);
    padding: 0.4rem 0;
    position: relative;
    transition: color 0.2s ease;
    white-space: nowrap;
  }

  .nav-text-compact {
    display: none;
  }
  .nav-text-full {
    display: inline;
  }

  .nav-link:hover {
    color: var(--color-mosque);
  }

  .nav-link.active {
    color: var(--color-mosque);
    font-weight: 600;
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--color-mosque);
    border-radius: 2px;
  }

  .navbar-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  /* Theme Toggle Button */
  .theme-toggle-btn {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    background-color: var(--color-white);
    color: var(--color-nordic);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: var(--transition);
    box-shadow: var(--shadow-sm);
    padding: 0;
    flex-shrink: 0;
  }

  .theme-toggle-btn:hover {
    border-color: var(--color-mosque);
    color: var(--color-mosque);
    transform: rotate(15deg);
  }

  :global([data-theme="dark"]) .brand-icon {
    background-color: var(--color-mosque);
    color: #0c1b18;
  }

  /* Icons visibility according to theme - Strong specificity */
  .theme-toggle-btn :global(.icon-light) {
    display: none !important;
  }
  .theme-toggle-btn :global(.icon-dark) {
    display: block !important;
  }

  :global(html[data-theme="dark"]) .theme-toggle-btn :global(.icon-light),
  :global([data-theme="dark"]) .theme-toggle-btn :global(.icon-light) {
    display: block !important;
  }

  :global(html[data-theme="dark"]) .theme-toggle-btn :global(.icon-dark),
  :global([data-theme="dark"]) .theme-toggle-btn :global(.icon-dark) {
    display: none !important;
  }

  @media (max-width: 640px) {
    .navbar-container {
      height: 56px;
      padding-left: 0.85rem;
      padding-right: 0.85rem;
    }
    .brand-subtitle {
      display: none;
    }
    .brand-title {
      font-size: 0.98rem;
    }
    .navbar-nav {
      gap: 0.65rem;
    }
    .nav-link {
      font-size: 0.82rem;
    }
    .nav-text-full {
      display: none;
    }
    .nav-text-compact {
      display: inline;
    }
    .navbar-actions {
      gap: 0.45rem;
    }
    .navbar-actions :global(.btn span) {
      display: none;
    }
    .navbar-actions :global(.btn) {
      padding: 0.45rem;
      border-radius: var(--radius-full);
      width: 34px;
      height: 34px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
  }

  @media (max-width: 390px) {
    .navbar-container {
      padding-left: 0.5rem;
      padding-right: 0.5rem;
    }
    .brand-icon {
      width: 30px;
      height: 30px;
    }
    .brand-title {
      font-size: 0.88rem;
    }
    .navbar-nav {
      gap: 0.45rem;
    }
    .nav-link {
      font-size: 0.76rem;
    }
    .navbar-actions {
      gap: 0.35rem;
    }
    .theme-toggle-btn {
      width: 32px;
      height: 32px;
    }
    .navbar-actions :global(.btn) {
      width: 32px;
      height: 32px;
      padding: 0.35rem;
    }
  }
</style>
