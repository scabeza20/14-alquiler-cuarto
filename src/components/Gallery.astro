---
import type { PropertyImage } from '../data/property';

interface Props {
  images: PropertyImage[];
}

const { images } = Astro.props;
---

<div class="gallery-component" id="property-gallery">
  <!-- Main Image Stage -->
  <div class="gallery-stage">
    <div class="stage-wrapper">
      <img
        id="gallery-main-img"
        src={images[0].src}
        alt={images[0].alt}
        class="main-img"
        loading="eager"
      />
      
      <!-- Badges -->
      <div class="gallery-badges">
        <span class="badge badge-promo">50% Depósito</span>
        <span class="badge badge-exclusive" id="gallery-counter">1 / {images.length}</span>
      </div>

      <!-- Navigation arrows -->
      <button class="gallery-nav-btn prev" id="gallery-prev" aria-label="Foto anterior">
        <span class="material-symbols-outlined">chevron_left</span>
      </button>
      <button class="gallery-nav-btn next" id="gallery-next" aria-label="Foto siguiente">
        <span class="material-symbols-outlined">chevron_right</span>
      </button>

      <!-- Caption -->
      <div class="stage-caption" id="gallery-caption">
        <span>{images[0].title}</span>
      </div>
    </div>
  </div>

  <!-- Thumbnails Row -->
  <div class="thumbnails-container">
    <div class="thumbnails-track" id="gallery-thumbnails">
      {images.map((img, idx) => (
        <button
          type="button"
          class={`thumb-btn ${idx === 0 ? 'active' : ''}`}
          data-index={idx}
          data-src={img.src}
          data-alt={img.alt}
          data-title={img.title}
          aria-label={`Ver ${img.title}`}
        >
          <img src={img.src} alt={img.alt} loading="lazy" />
          <span class="thumb-index">{idx + 1}</span>
        </button>
      ))}
    </div>
  </div>
</div>

<script>
  function initGallery() {
    const gallery = document.getElementById('property-gallery');
    if (!gallery) return;

    const mainImg = document.getElementById('gallery-main-img') as HTMLImageElement;
    const caption = document.getElementById('gallery-caption');
    const counter = document.getElementById('gallery-counter');
    const prevBtn = document.getElementById('gallery-prev');
    const nextBtn = document.getElementById('gallery-next');
    const thumbBtns = gallery.querySelectorAll<HTMLButtonElement>('.thumb-btn');

    let currentIndex = 0;
    const total = thumbBtns.length;

    function showImage(index: number) {
      if (index < 0) index = total - 1;
      if (index >= total) index = 0;
      currentIndex = index;

      const targetBtn = thumbBtns[currentIndex];
      if (!targetBtn || !mainImg) return;

      const src = targetBtn.getAttribute('data-src') || '';
      const alt = targetBtn.getAttribute('data-alt') || '';
      const title = targetBtn.getAttribute('data-title') || '';

      mainImg.src = src;
      mainImg.alt = alt;

      if (caption) {
        caption.innerHTML = `<span>${title}</span>`;
      }
      if (counter) {
        counter.textContent = `${currentIndex + 1} / ${total}`;
      }

      thumbBtns.forEach((btn, i) => {
        if (i === currentIndex) {
          btn.classList.add('active');
          btn.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        } else {
          btn.classList.remove('active');
        }
      });
    }

    thumbBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = parseInt(btn.getAttribute('data-index') || '0', 10);
        showImage(idx);
      });
    });

    if (prevBtn) {
      prevBtn.addEventListener('click', () => showImage(currentIndex - 1));
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => showImage(currentIndex + 1));
    }

    // Keyboard support
    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') showImage(currentIndex - 1);
      if (e.key === 'ArrowRight') showImage(currentIndex + 1);
    });
  }

  initGallery();
  document.addEventListener('astro:page-load', initGallery);
</script>

<style>
  .gallery-component {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .gallery-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    max-height: 420px;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background-color: var(--color-nordic);
    box-shadow: var(--shadow-card);
  }

  .stage-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .main-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.25s ease;
  }

  .gallery-badges {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    display: flex;
    gap: 0.4rem;
    z-index: 2;
  }

  .gallery-nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 38px;
    height: 38px;
    border-radius: var(--radius-full);
    background-color: rgba(255, 255, 255, 0.9);
    color: var(--color-nordic);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: var(--shadow-sm);
    transition: var(--transition);
    z-index: 3;
  }

  :global([data-theme="dark"]) .gallery-nav-btn {
    background-color: rgba(20, 41, 37, 0.9);
    color: var(--color-nordic);
  }

  .gallery-nav-btn:hover {
    background-color: var(--color-white);
    color: var(--color-mosque);
    transform: translateY(-50%) scale(1.08);
  }

  .gallery-nav-btn.prev {
    left: 0.85rem;
  }

  .gallery-nav-btn.next {
    right: 0.85rem;
  }

  .stage-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1rem 1.25rem;
    background: linear-gradient(to top, rgba(12, 27, 24, 0.85) 0%, transparent 100%);
    color: #FFFFFF;
    font-size: 0.95rem;
    font-weight: 500;
    display: flex;
    align-items: center;
  }

  /* Thumbnails */
  .thumbnails-container {
    width: 100%;
    overflow-x: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--color-border) transparent;
    padding-bottom: 0.35rem;
  }

  .thumbnails-track {
    display: flex;
    gap: 0.65rem;
  }

  .thumb-btn {
    position: relative;
    flex: 0 0 95px;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 2px solid transparent;
    padding: 0;
    cursor: pointer;
    background: none;
    opacity: 0.65;
    transition: var(--transition);
  }

  .thumb-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .thumb-btn:hover {
    opacity: 0.9;
    transform: translateY(-2px);
  }

  .thumb-btn.active {
    opacity: 1;
    border-color: var(--color-mosque);
    box-shadow: 0 0 0 2px rgba(0, 102, 85, 0.25);
  }

  .thumb-index {
    position: absolute;
    bottom: 3px;
    right: 3px;
    background-color: rgba(12, 27, 24, 0.8);
    color: #FFFFFF;
    font-size: 0.65rem;
    padding: 1px 4px;
    border-radius: var(--radius-sm);
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .gallery-stage {
      aspect-ratio: 4 / 3;
      max-height: 280px;
    }
    .thumb-btn {
      flex: 0 0 75px;
    }
    .gallery-nav-btn {
      width: 32px;
      height: 32px;
    }
    .gallery-nav-btn.prev {
      left: 0.5rem;
    }
    .gallery-nav-btn.next {
      right: 0.5rem;
    }
  }
</style>
