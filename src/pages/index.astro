---
import Layout from '../layouts/Layout.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { property } from '../data/property';
---

<Layout 
  title="Alquiler de Apartamento en Tocumen | $250/mes Negociable"
  description="Apartamento independiente en La Siesta de Tocumen, Panamá. 200 m², baño privado, área de lavado. $250/mes con 50% de descuento en el depósito."
>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container hero-container">
      <div class="hero-badge">
        <span class="material-symbols-outlined">verified</span>
        <span>Alquiler Disponible en Tocumen, Panamá</span>
      </div>

      <h1 class="hero-title">
        Encuentra tu próximo <span class="highlight">espacio</span> ideal.
      </h1>

      <p class="hero-description">
        Apartamento independiente en La Siesta de Tocumen. Disfruta de <strong>200 m²</strong> de espacio, baño privado, área de lavado y total privacidad. Aprovecha nuestra promoción especial de <strong>50% de descuento en el depósito</strong> para ingresar.
      </p>

      <div class="hero-cta-group">
        <a href="/detalle" class="btn btn-primary btn-lg">
          <span class="material-symbols-outlined">visibility</span>
          <span>Ver Fotos y Detalles</span>
        </a>
        <WhatsAppButton size="lg" text="Chatear por WhatsApp" />
      </div>

      <!-- Quick Metrics Ribbon (Cuadrícula 2x2 en móvil) -->
      <div class="metrics-ribbon">
        <div class="metric-item">
          <span class="metric-label">Precio Mensual</span>
          <span class="metric-value">{property.priceFormatted} <small class="metric-note">Negociable</small></span>
        </div>
        <div class="metric-divider"></div>
        <div class="metric-item">
          <span class="metric-label">Espacio Total</span>
          <span class="metric-value">{property.area} {property.areaUnit}</span>
        </div>
        <div class="metric-divider"></div>
        <div class="metric-item">
          <span class="metric-label">Baño</span>
          <span class="metric-value">{property.bathrooms} Privado</span>
        </div>
        <div class="metric-divider"></div>
        <div class="metric-item">
          <span class="metric-label">Promoción</span>
          <span class="metric-value text-mosque">50% Depósito</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Property Card Section -->
  <section class="featured-section">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="section-eyebrow">Inmueble Destacado</span>
          <h2 class="section-title">El Apartamento</h2>
        </div>
        <a href="/detalle" class="section-link">
          <span>Ver ficha completa</span>
          <span class="material-symbols-outlined">arrow_forward</span>
        </a>
      </div>

      <article class="featured-card">
        <div class="card-media">
          <img 
            src={property.images[0].src} 
            alt={property.images[0].alt}
            class="card-img"
            loading="eager"
          />
          <div class="media-badges">
            <span class="badge badge-exclusive">Disponible</span>
            <span class="badge badge-promo">50% Depósito</span>
          </div>
        </div>

        <div class="card-content">
          <div class="card-top">
            <div class="card-price-wrap">
              <span class="card-price">{property.priceFormatted}</span>
              <span class="card-price-period">/ mes</span>
              <span class="card-price-badge">{property.priceNote}</span>
            </div>
            <h3 class="card-title">
              <a href="/detalle">{property.title}</a>
            </h3>
            <p class="card-location">
              <span class="material-symbols-outlined">location_on</span>
              <span>{property.location.street}, {property.location.barriada}</span>
            </p>
          </div>

          <p class="card-desc">
            {property.description}
          </p>

          <div class="specs-grid">
            <div class="spec-chip">
              <span class="material-symbols-outlined">square_foot</span>
              <span>{property.area} m²</span>
            </div>
            <div class="spec-chip">
              <span class="material-symbols-outlined">shower</span>
              <span>{property.bathrooms} Baño</span>
            </div>
            <div class="spec-chip">
              <span class="material-symbols-outlined">group</span>
              <span>Máx. {property.maxOccupancy} pers.</span>
            </div>
            <div class="spec-chip">
              <span class="material-symbols-outlined">door_front</span>
              <span>Independiente</span>
            </div>
          </div>

          <div class="card-actions">
            <a href="/detalle" class="btn btn-primary">
              <span class="material-symbols-outlined">info</span>
              <span>Ver Fotos y Detalles</span>
            </a>
            <WhatsAppButton text="Consultar por WhatsApp" />
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- Photo Preview Gallery -->
  <section class="gallery-preview-section">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="section-eyebrow">Galería de Imágenes</span>
          <h2 class="section-title">Fotos Reales del Inmueble</h2>
        </div>
        <a href="/detalle" class="section-link">
          <span>Ver las 8 fotos</span>
          <span class="material-symbols-outlined">photo_library</span>
        </a>
      </div>

      <div class="preview-grid">
        {property.images.slice(0, 4).map((img) => (
          <a href="/detalle" class="preview-item group">
            <img src={img.src} alt={img.alt} loading="lazy" />
            <div class="preview-overlay">
              <span class="preview-label">{img.title}</span>
              <span class="material-symbols-outlined">zoom_in</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Key Advantages Section -->
  <section class="advantages-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-eyebrow">Beneficios Clave</span>
        <h2 class="section-title">¿Por qué elegir este apartamento?</h2>
      </div>

      <div class="advantages-grid">
        <div class="advantage-card">
          <div class="advantage-icon">
            <span class="material-symbols-outlined">key</span>
          </div>
          <h3 class="advantage-title">Entrada 100% Independiente</h3>
          <p class="advantage-text">
            Acceso totalmente autónomo para tu mayor tranquilidad, privacidad y comodidad sin interferencias.
          </p>
        </div>

        <div class="advantage-card">
          <div class="advantage-icon">
            <span class="material-symbols-outlined">local_offer</span>
          </div>
          <h3 class="advantage-title">Promoción 50% en Depósito</h3>
          <p class="advantage-text">
            Facilitamos tu mudanza: solo requieres la mitad del depósito para ingresar. Precio mensual de $250 negociable.
          </p>
        </div>

        <div class="advantage-card">
          <div class="advantage-icon">
            <span class="material-symbols-outlined">local_laundry_service</span>
          </div>
          <h3 class="advantage-title">Área de Lavado & 200 m²</h3>
          <p class="advantage-text">
            Cuenta con su propio espacio de lavado e instalaciones cómodas. Ideal para parejas o personas trabajadoras.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Bottom CTA Banner -->
  <section class="cta-banner-section">
    <div class="container">
      <div class="cta-banner">
        <div class="cta-text">
          <span class="badge badge-promo mb-2">Contacto Directo</span>
          <h2 class="cta-title">¿Te interesa este apartamento?</h2>
          <p class="cta-subtitle">
            Agenda una visita o haz tus preguntas directamente por WhatsApp o mediante nuestro formulario.
          </p>
        </div>
        <div class="cta-buttons">
          <WhatsAppButton size="lg" text="Escribir por WhatsApp" />
          <a href="/detalle#contacto" class="btn btn-secondary btn-lg">
            <span class="material-symbols-outlined">mail</span>
            <span>Formulario de Contacto</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ==========================================================================
     Hero Section
     ========================================================================== */
  .hero-section {
    padding: 2.75rem 0 2.25rem;
    text-align: center;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.85rem;
    background-color: var(--color-mosque-light);
    color: var(--color-mosque);
    border: 1px solid var(--color-border-card);
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 1.15rem;
  }

  .hero-badge span:first-child {
    font-size: 1rem;
  }

  .hero-title {
    font-size: clamp(1.85rem, 3.5vw, 2.45rem);
    font-weight: 400;
    line-height: 1.2;
    color: var(--color-nordic);
    max-width: 680px;
    margin-bottom: 1.15rem;
    letter-spacing: -0.02em;
  }

  .hero-title .highlight {
    position: relative;
    font-weight: 700;
    color: var(--color-mosque);
    white-space: nowrap;
  }

  .hero-title .highlight::after {
    content: '';
    position: absolute;
    bottom: 3px;
    left: 0;
    width: 100%;
    height: 8px;
    background-color: var(--color-mosque-light);
    border-radius: 4px;
    z-index: -1;
    transform: rotate(-1deg);
  }

  .hero-description {
    font-size: 1rem;
    color: var(--color-nordic-muted);
    max-width: 620px;
    margin-bottom: 1.75rem;
    line-height: 1.6;
  }

  .hero-cta-group {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }

  /* Metrics Ribbon */
  .metrics-ribbon {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-white);
    padding: 0.85rem 2rem;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-card);
    border: 1px solid var(--color-border-card);
    max-width: 740px;
    width: 100%;
  }

  .metric-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
  }

  .metric-label {
    font-size: 0.7rem;
    color: var(--color-nordic-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.2rem;
  }

  .metric-value {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-nordic);
  }

  .metric-note {
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--color-mosque);
    margin-left: 0.2rem;
  }

  .text-mosque {
    color: var(--color-mosque);
  }

  .metric-divider {
    width: 1px;
    height: 30px;
    background-color: var(--color-border);
    margin: 0 1rem;
  }

  /* ==========================================================================
     Section Headers
     ========================================================================== */
  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .section-header.text-center {
    justify-content: center;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .section-eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-mosque);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 0.25rem;
  }

  .section-title {
    font-size: 1.55rem;
    font-weight: 600;
    color: var(--color-nordic);
    letter-spacing: -0.02em;
  }

  .section-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-mosque);
    transition: var(--transition);
  }

  .section-link:hover {
    color: var(--color-mosque-hover);
    transform: translateX(3px);
  }

  /* ==========================================================================
     Featured Card
     ========================================================================== */
  .featured-section {
    padding: 2.25rem 0;
  }

  .featured-card {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    background-color: var(--color-white);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    border: 1px solid var(--color-border-card);
    transition: var(--transition);
  }

  .featured-card:hover {
    box-shadow: var(--shadow-hover);
  }

  .card-media {
    position: relative;
    min-height: 280px;
    overflow: hidden;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  .featured-card:hover .card-img {
    transform: scale(1.03);
  }

  .media-badges {
    position: absolute;
    top: 1rem;
    left: 1rem;
    display: flex;
    gap: 0.4rem;
  }

  .card-content {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .card-price-wrap {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    margin-bottom: 0.35rem;
  }

  .card-price {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-mosque);
  }

  .card-price-period {
    font-size: 0.9rem;
    color: var(--color-nordic-muted);
  }

  .card-price-badge {
    background-color: var(--color-mosque-light);
    color: var(--color-mosque);
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm);
    margin-left: 0.35rem;
  }

  .card-title {
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--color-nordic);
    margin-bottom: 0.35rem;
    line-height: 1.3;
  }

  .card-title a:hover {
    color: var(--color-mosque);
  }

  .card-location {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--color-nordic-muted);
    font-size: 0.85rem;
    margin-bottom: 1rem;
  }

  .card-location span:first-child {
    font-size: 1rem;
    color: var(--color-mosque);
  }

  .card-desc {
    color: var(--color-nordic-muted);
    font-size: 0.875rem;
    line-height: 1.55;
    margin-bottom: 1.25rem;
  }

  .specs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.6rem;
    padding: 1rem 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 1.25rem;
  }

  .spec-chip {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-nordic);
    font-size: 0.825rem;
    font-weight: 500;
  }

  .spec-chip span:first-child {
    font-size: 1.1rem;
    color: var(--color-mosque);
  }

  .card-actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  /* ==========================================================================
     Gallery Preview Grid
     ========================================================================== */
  .gallery-preview-section {
    padding: 2.25rem 0;
  }

  .preview-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.85rem;
  }

  .preview-item {
    position: relative;
    aspect-ratio: 16 / 11;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .preview-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .preview-item:hover img {
    transform: scale(1.05);
  }

  .preview-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(12, 27, 24, 0.85) 0%, transparent 65%);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    color: #FFFFFF;
    opacity: 0.85;
    transition: opacity 0.2s ease;
  }

  .preview-item:hover .preview-overlay {
    opacity: 1;
  }

  .preview-label {
    font-size: 0.8rem;
    font-weight: 500;
  }

  /* ==========================================================================
     Advantages Section
     ========================================================================== */
  .advantages-section {
    padding: 2.75rem 0;
  }

  .advantages-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 0.75rem;
  }

  .advantage-card {
    background-color: var(--color-white);
    padding: 1.65rem 1.35rem;
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-border-card);
    box-shadow: var(--shadow-card);
    transition: var(--transition);
  }

  .advantage-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-hover);
  }

  .advantage-icon {
    width: 44px;
    height: 44px;
    background-color: var(--color-mosque-light);
    color: var(--color-mosque);
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.15rem;
  }

  .advantage-icon span {
    font-size: 24px;
  }

  .advantage-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-nordic);
    margin-bottom: 0.5rem;
  }

  .advantage-text {
    color: var(--color-nordic-muted);
    font-size: 0.85rem;
    line-height: 1.55;
  }

  /* ==========================================================================
     Bottom CTA Banner
     ========================================================================== */
  .cta-banner-section {
    padding: 2.25rem 0 3rem;
  }

  .cta-banner {
    background: linear-gradient(135deg, var(--color-nordic) 0%, #162e2a 100%);
    border-radius: var(--radius-xl);
    padding: 2.5rem 2.25rem;
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    box-shadow: var(--shadow-card);
  }

  :global([data-theme="dark"]) .cta-banner {
    background: linear-gradient(135deg, #142925 0%, #0d1f1c 100%);
    border: 1px solid var(--color-border-card);
  }

  .cta-title {
    font-size: 1.65rem;
    font-weight: 600;
    color: #FFFFFF;
    margin-bottom: 0.5rem;
  }

  .cta-subtitle {
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.95rem;
    max-width: 500px;
    line-height: 1.55;
  }

  .cta-buttons {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    flex-shrink: 0;
  }

  /* ==========================================================================
     Responsive Media Queries
     ========================================================================== */
  @media (max-width: 1024px) {
    .featured-card {
      grid-template-columns: 1fr;
    }
    .card-media {
      min-height: 250px;
    }
    .preview-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .advantages-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .cta-banner {
      flex-direction: column;
      text-align: center;
      padding: 2rem 1.5rem;
    }
    .cta-buttons {
      justify-content: center;
    }
  }

  @media (max-width: 640px) {
    .hero-title {
      font-size: 1.85rem;
    }
    /* Cuadrícula 2x2 en móviles para evitar scroll vertical largo */
    .metrics-ribbon {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
      padding: 1.15rem 1rem;
    }
    .metric-divider {
      display: none;
    }
    .metric-item {
      text-align: center;
    }
    .card-content {
      padding: 1.25rem;
    }
    .specs-grid {
      grid-template-columns: 1fr 1fr;
    }
    .card-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .card-actions :global(.btn) {
      width: 100%;
    }
    .preview-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
