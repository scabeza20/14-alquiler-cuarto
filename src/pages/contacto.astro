---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { property } from '../data/property';

const title = `Contacto | ${property.title}`;
const description = `Envía tu consulta o ponte en contacto para alquilar el apartamento independiente en La Siesta de Tocumen por ${property.priceFormatted}/mes con 50% de descuento en el depósito.`;
---

<Layout title={title} description={description}>
  <section class="contact-page-section">
    <div class="container contact-container">
      
      <!-- Back Navigation -->
      <nav class="breadcrumb-nav" aria-label="Ruta de navegación">
        <a href="/detalle" class="back-link">
          <span class="material-symbols-outlined">arrow_back</span>
          Volver a detalles del apartamento
        </a>
      </nav>

      <!-- Page Header -->
      <header class="contact-header">
        <div class="property-tag">
          <span class="material-symbols-outlined tag-icon">apartment</span>
          <span>La Siesta de Tocumen &bull; {property.priceFormatted}/mes</span>
        </div>
        <h1 class="page-title">Formulario de Contacto</h1>
        <p class="page-subtitle">
          Completa los campos a continuación para solicitar información o coordinar una visita. Te responderemos lo antes posible.
        </p>
      </header>

      <!-- WhatsApp Shortcut Card -->
      <aside class="whatsapp-card" aria-label="Contacto por WhatsApp">
        <div class="whatsapp-card-content">
          <div class="whatsapp-card-icon">
            <span class="material-symbols-outlined">chat</span>
          </div>
          <div class="whatsapp-card-text">
            <strong>¿Prefieres atención inmediata?</strong>
            <span>Escríbenos directamente por WhatsApp para coordinar tu cita o aclarar dudas.</span>
          </div>
        </div>
        <div class="whatsapp-card-action">
          <WhatsAppButton text="Abrir WhatsApp" size="sm" />
        </div>
      </aside>

      <!-- Main Form Wrapper -->
      <main class="form-wrapper">
        <div class="form-card">
          <div class="form-card-header">
            <h2 class="form-card-title">Envíanos un Mensaje</h2>
            <p class="form-card-desc">
              Todos los mensajes son recibidos de forma privada y segura.
            </p>
          </div>
          
          <ContactForm />
        </div>
      </main>

      <!-- Extra Property Info Box -->
      <footer class="property-summary-box">
        <div class="summary-item">
          <span class="material-symbols-outlined summary-icon">payments</span>
          <div>
            <strong>$250 / mes ({property.priceNote})</strong>
            <p>{property.depositPromo}</p>
          </div>
        </div>
        <div class="summary-item">
          <span class="material-symbols-outlined summary-icon">pin_drop</span>
          <div>
            <strong>Ubicación en Tocumen</strong>
            <p>{property.location.corregimiento}, {property.location.barriada}, {property.location.street}</p>
          </div>
        </div>
      </footer>

    </div>
  </section>
</Layout>

<style>
  .contact-page-section {
    padding: 2rem 0 3.5rem;
    min-height: calc(100vh - 64px - 200px);
  }

  .contact-container {
    max-width: 680px;
    margin: 0 auto;
  }

  /* Breadcrumb */
  .breadcrumb-nav {
    margin-bottom: 1.25rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-nordic-muted);
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .back-link span {
    font-size: 18px;
  }

  .back-link:hover {
    color: var(--color-mosque);
    transform: translateX(-2px);
  }

  /* Header */
  .contact-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .property-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.85rem;
    border-radius: var(--radius-full);
    background-color: var(--color-mosque-light);
    color: var(--color-mosque);
    font-size: 0.775rem;
    font-weight: 600;
    margin-bottom: 0.85rem;
    border: 1px solid var(--color-border-card);
  }

  .property-tag .tag-icon {
    font-size: 16px;
  }

  .page-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-nordic);
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin-bottom: 0.5rem;
  }

  .page-subtitle {
    color: var(--color-nordic-muted);
    font-size: 0.925rem;
    line-height: 1.55;
    max-width: 540px;
    margin: 0 auto;
  }

  /* WhatsApp Shortcut Card */
  .whatsapp-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-whatsapp);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    margin-bottom: 1.75rem;
    box-shadow: var(--shadow-sm);
    transition: var(--transition);
  }

  .whatsapp-card-content {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .whatsapp-card-icon {
    width: 38px;
    height: 38px;
    background-color: rgba(37, 211, 102, 0.12);
    color: var(--color-whatsapp);
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .whatsapp-card-icon span {
    font-size: 22px;
  }

  .whatsapp-card-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .whatsapp-card-text strong {
    color: var(--color-nordic);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .whatsapp-card-text span {
    color: var(--color-nordic-muted);
    font-size: 0.8rem;
    line-height: 1.4;
  }

  /* Form Card */
  .form-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-border-card);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    padding: 2rem 2rem;
    transition: var(--transition);
  }

  .form-card-header {
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .form-card-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-nordic);
    letter-spacing: -0.01em;
    margin-bottom: 0.25rem;
  }

  .form-card-desc {
    color: var(--color-nordic-muted);
    font-size: 0.85rem;
  }

  /* Property Summary Box */
  .property-summary-box {
    margin-top: 1.75rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    background-color: var(--color-white);
    border: 1px solid var(--color-border-card);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    box-shadow: var(--shadow-sm);
  }

  .summary-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .summary-icon {
    color: var(--color-mosque);
    font-size: 20px;
    padding: 0.35rem;
    background-color: var(--color-mosque-light);
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  .summary-item strong {
    display: block;
    color: var(--color-nordic);
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 0.15rem;
  }

  .summary-item p {
    color: var(--color-nordic-muted);
    font-size: 0.775rem;
    line-height: 1.4;
    margin: 0;
  }

  /* Responsive Adjustments */
  @media (max-width: 640px) {
    .contact-page-section {
      padding: 1.25rem 0 2.5rem;
    }

    .page-title {
      font-size: 1.4rem;
    }

    .form-card {
      padding: 1.25rem 1rem;
    }

    .whatsapp-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.85rem;
      padding: 1rem;
    }

    .whatsapp-card-action {
      width: 100%;
    }

    .whatsapp-card-action :global(.btn) {
      width: 100%;
    }

    .property-summary-box {
      grid-template-columns: 1fr;
      gap: 0.85rem;
      padding: 1rem;
    }
  }
</style>
